{
  "name": "jfkarlstad-web",
  "version": "1.0.0",
  "private": true,
  "description": "Webbplats för Juridiska Föreningen i Karlstad (Cloudflare Worker + D1 + KV)",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply jfkarlstad --local",
    "db:seed:local": "wrangler d1 execute jfkarlstad --local --file=seed/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply jfkarlstad --remote",
    "preview:node": "tsc -p tools/local-preview/tsconfig.json && node --no-warnings tools/local-preview/server.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "wrangler": "^4.0.0"
  }
}
